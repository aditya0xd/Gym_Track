
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Member {
  id               String               @id @default(uuid())
  fullName         String
  email            String?              @unique
  phone            String
  billingDuration  MemberBillingDuration
  planPrice        Decimal              @db.Decimal(10, 2)
  paymentStatus    PaymentStatus        @default(NOT_DONE)
  memberPhoto      String?              @db.Text
  upiScreenshot    String?              @db.Text
  startDate        DateTime             @db.Date
  endDate          DateTime             @db.Date
  whatsappEnabled  Boolean              @default(true)
  adminUserId      String
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  adminUser        AdminUser            @relation(fields: [adminUserId], references: [id])
  reminders        ReminderLog[]

  @@index([adminUserId])
}

model ReminderLog {
  id        String          @id @default(uuid())
  memberId  String
  member    Member          @relation(fields: [memberId], references: [id])
  channel   Channel
  sentAt    DateTime        @default(now())
  status    ReminderStatus
  message   String
}

/// Gym owner (tenant)
model AdminUser {
  id               String                  @id @default(uuid())
  name             String
  email            String                  @unique
  passwordHash     String
  subscriptionPlan OwnerSubscriptionPlan   @default(TRIAL)
  trialEndsAt      DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  members          Member[]
  durationPrices   GymOwnerDurationPrice[]
  billingInvoices  OwnerBillingInvoice[]
}

/// Platform operator
model SuperAdminUser {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// INR list prices per duration — set by each gym owner
model GymOwnerDurationPrice {
  id          String               @id @default(uuid())
  adminUserId String
  duration    MemberBillingDuration
  priceInr    Decimal              @db.Decimal(10, 2)
  adminUser   AdminUser            @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@unique([adminUserId, duration])
  @@index([adminUserId])
}

model PlatformPlanPrice {
  id        String                @id @default(uuid())
  plan      OwnerSubscriptionPlan @unique
  priceInr  Decimal               @db.Decimal(10, 2)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
}

model OwnerBillingInvoice {
  id          String                @id @default(uuid())
  adminUserId String
  plan        OwnerSubscriptionPlan
  amountInr   Decimal               @db.Decimal(10, 2)
  status      BillingStatus         @default(PENDING)
  provider    PaymentProvider       @default(MANUAL)
  razorpayOrderId   String?         @unique
  razorpayPaymentId String?
  razorpaySignature String?
  dueDate     DateTime              @db.Date
  paidAt      DateTime?
  createdAt   DateTime              @default(now())
  adminUser   AdminUser             @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId, createdAt])
}

enum OwnerSubscriptionPlan {
  TRIAL
  STARTER
  PRO
}

enum MemberBillingDuration {
  ONE_MONTH
  THREE_MONTHS
  SIX_MONTHS
  TWELVE_MONTHS
}

enum Channel {
  WHATSAPP
  SMS
}

enum ReminderStatus {
  SENT
  FAILED
  DELIVERED
}

enum PaymentStatus {
  DONE
  NOT_DONE
}

enum BillingStatus {
  PENDING
  PAID
  FAILED
}

enum PaymentProvider {
  MANUAL
  RAZORPAY
}
